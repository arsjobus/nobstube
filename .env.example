APP_NAME=NoBSTube
DATABASE_PATH=data/videos.db
RULES_PATH=config/rules.yaml
HOST=0.0.0.0
PORT=8000

# AI configuration.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=90
OLLAMA_ENABLED=true
OLLAMA_BATCH_SIZE=10
OLLAMA_THINK=false
OLLAMA_MAX_CONCURRENT=1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Comma-separated frontend origins allowed to call the API (use * for local development).
CORS_ORIGINS=*
